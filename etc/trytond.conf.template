# Template for trytond configuration.
# Copy to etc/trytond.conf and fill in locally. etc/trytond.conf is git-ignored.
# Non-negotiable: no production credentials belong in this repository.

[database]
uri = postgresql://tryton:tryton@127.0.0.1:5432/
path = /var/lib/trytond
language = en

[web]
listen = localhost:8000
root = /var/www/tryton

[session]
timeout = 3600

[cache]
model = 200
record = 2000
field = 100
